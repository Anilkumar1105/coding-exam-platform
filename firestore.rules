rules_version = '2';

// NOTE: This is a client-only project (no Cloud Functions / backend).
// Because of that, "hiddenTestCases" on questions cannot be fully hidden
// from a signed-in student at the database level - any authenticated
// client can technically read a question document. Treat hidden test
// cases as "hidden from the UI", not as secret data. If you need true
// server-side secrecy, move grading into a Cloud Function later.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // exams/{examId}
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // questions/{questionId}
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // submissions/{submissionId}
    match /submissions/{submissionId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid;

      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid &&
         resource.data.status == 'in-progress');

      allow delete: if isAdmin();
    }
  }
}
